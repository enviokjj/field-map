# 현장 지도 서버 설정 — 이 파일을 .env 로 복사해 채운다.
#
# DB_URL  PostGIS 접속. terrain.road_line · terrain.boundary 두 테이블만 읽는다(읽기 전용).
#         ★운영 DB 에 붙일 때는 **읽기 전용 계정**을 쓸 것.
DB_URL=postgresql+psycopg2://readonly:<pw>@127.0.0.1:5432/terrain
#
# ALLOWED_ORIGINS  이 서버를 부를 수 있는 페이지의 출처. 쉼표 구분.
#         기본 * 는 개발용이다 — 운영에서는 도메인을 적을 것.
ALLOWED_ORIGINS=*
